<mujoco model="two_link_arm">
  <option gravity="0 0 -9.81"/>
  <worldbody>
    <light diffuse=".6 .6 .6" pos="0 0 3" dir="0 0 -1"/>
    <geom type="plane" size="2 2 0.1" rgba=".9 .9 .9 1"/>

    <!-- Base, fixed to the world -->
    <body name="base" pos="0 0 0.1">
      <geom type="cylinder" size="0.05 0.05" rgba=".3 .3 .3 1"/>

      <!-- Link 1 -->
      <body name="link1" pos="0 0 0.05">
        <joint name="joint1" type="hinge" axis="0 0 1" pos="0 0 0"/>
        <geom type="capsule" fromto="0 0 0  0.3 0 0" size="0.03" rgba="1 0 0 1"/>

        <!-- Link 2 -->
        <body name="link2" pos="0.3 0 0">
          <joint name="joint2" type="hinge" axis="0 0 1" pos="0 0 0"/>
          <geom type="capsule" fromto="0 0 0  0.3 0 0" size="0.03" rgba="0 0 1 1"/>

          <!-- End-effector marker -->
          <body name="end_effector" pos="0.3 0 0">
            <geom type="sphere" size="0.04" rgba="0 1 0 1"/>
          </body>
        </body>
      </body>
    </body>

    <!-- Target: fixed in world space, NOT attached to the arm -->
    <body name="target" pos="0.4 0.3 0.15">
      <geom type="sphere" size="0.03" rgba="1 1 0 0.6" contype="0" conaffinity="0"/>
    </body>

  </worldbody>

  <actuator>
    <motor joint="joint1" gear="50" ctrlrange="-1 1"/>
    <motor joint="joint2" gear="50" ctrlrange="-1 1"/>
  </actuator>
</mujoco>